{
    "name": "antlion/silverwind-blocks",
    "description": "Elemental content blocks for the Silverwind theme (Tailwind CSS 4, daisyUI 5, Alpine.js): hero, card, buttons, menu, accordion, tabs, container, grid, list, modal, gallery, carousel and slider",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "keywords": ["silverstripe", "elemental", "blocks", "silverwind", "tailwind", "daisyui", "alpinejs", "swiper"],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silverstripe/cms": "^6.0",
        "silverstripe/linkfield": "^5.0",
        "dnadesign/silverstripe-elemental": "^6.0",
        "symbiote/silverstripe-gridfieldextensions": "^5.0",
        "unclecheese/display-logic": "^4.0",
        "antlion/silverwind-settings": "^1.0@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "colymba/gridfield-bulk-editing-tools": "Bulk upload images to a gallery",
        "jonom/focuspoint": "Focus-point aware cropping and background positioning"
    },
    "autoload": {
        "psr-4": {
            "Antlion\\SilverwindBlocks\\": "src/",
            "Antlion\\SilverwindBlocks\\Tests\\": "tests/"
        }
    },
    "extra": {
        "expose": [
            "client/dist"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
